<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="matrix_view.MatrixRenderer">
        <t t-call="{{ props.buttonTemplate }}"/>
        <div t-if="model.hasData() and model.metaData.activeMeasures.length" 
            class="o_matrix mx-3 table-responsive">
            <table class="table table-sm table-bordered">
                <!-- Column Group Headers -->
                <thead>
                    <tr t-foreach="table.headers" t-as="headerRow" t-key="'header_' + headerRow_index">
                        <!-- Empty cells for row fields -->
                        <t t-if="headerRow_index == 0">
                            <th t-att-colspan="model.metaData.rowGroupBys.length-1" 
                                t-att-rowspan="table.headers.length"
                                class="">
                                <t t-if="state.isEditing">
                                    <!--<button class="btn-link">Add a line</button>-->
                                    <a href="#" role="button" tabindex="0" class="add_line" t-on-click="() => this.onAddLineClicked(table.rows[0],model)">Add a line</a>
                                </t>
                            </th>
                        </t>
                        
                        <!-- Column group headers -->
                        <t t-foreach="headerRow" t-as="cell" t-key="'header_row_' + cell_index">
                            <th t-att-colspan="cell.width" 
                                t-att-rowspan="cell.height"
                                class="text-center"
                                t-att-class="{
                                    'cursor-pointer': cell.isLeaf !== undefined,
                                    'bg-light': cell.isLeaf
                                }"
                                t-on-click.prevent="() => cell.isLeaf !== undefined &amp;&amp; this.onHeaderClick(cell, 'col')">
                                <span t-esc="cell.title"/>
                                <t t-if="cell_index==headerRow.length-1">
                                    <t t-if="state.isEditing">
                                        <i class="fa fa-plus-square me-1" data-tooltip="Add a column" title="" 
                                            style="margin-left:20px!important;" t-on-click="onAddColumnClicked"/>
                                    </t>
                                </t>
                            </th>
                        </t>
                    </tr>
                    
                    <!-- Row Field Headers -->
                    <tr>
                        <t t-foreach="model.metaData.rowGroupBys" t-as="rowField" t-key="rowField">
                            <t t-set="fieldName" t-value="rowField.split(':')[0]"/>
                            <t t-if="!model.metaData.fieldAttrs[fieldName] || !model.metaData.fieldAttrs[fieldName].isInvisible">
                                <th class="text-center">
                                    <span t-esc="model.metaData.fields[fieldName].string"/>
                                </th>
                            </t>
                        </t>
                        
                        <!-- Measure headers for each column group -->
                        <t t-foreach="table.headers[table.headers.length - 1]" t-as="colGroup" t-key="'measure_' + colGroup_index">
                            <t t-foreach="model.metaData.activeMeasures" t-as="measure" t-key="measure">
                                <th class="text-center">
                                    <span t-esc="model.metaData.measures[measure].string"/>
                                </th>
                            </t>
                        </t>
                    </tr>
                </thead>
                
                <!-- Data Rows -->
                <tbody>
                    <tr t-foreach="table.rows" t-as="row" t-key="'row_' + row_index">
                        <!-- Row fields as separate columns -->
                        <!--<t t-foreach="model.metaData.rowGroupBys" t-as="rowField" t-key="rowField">
                            <t t-set="fieldName" t-value="rowField.split(':')[0]"/>
                            <t t-if="!model.metaData.fieldAttrs[fieldName] || !model.metaData.fieldAttrs[fieldName].isInvisible">
                                <td class="text-left">
                                    <span t-esc="row.data[fieldName]?.label"/>
                                </td>
                            </t>
                        </t>-->
                        <t t-foreach="model.metaData.rowGroupBys" t-as="rowField" t-key="rowField">
                            <t t-set="fieldName" t-value="rowField.split(':')[0]"/>
                            <t t-if="!model.metaData.fieldAttrs[fieldName] || !model.metaData.fieldAttrs[fieldName].isInvisible">
                                <t t-if="state.isEditing and getFieldType(fieldName) === 'many2one'">
                                    <td class="text-left o_data_cell cursor-pointer o_field_cell o_list_many2one" 
                                        data-tooltip-delay="1000" tabindex="-1" t-att-name="fieldName" 
                                        t-att-data-tooltip="row.data[fieldName]?.label" title="">
                                        <div t-att-name="fieldName" class="o_field_widget o_field_many2one">
                                            <div class="o_field_many2one_selection">
                                                <div class="o_input_dropdown" t-on-click="(ev) => this.displayMany2oneRecord(ev,fieldName,row_index,row)"
                                                    t-att-id="'div_'+row_index +'_' +fieldName">
                                                    <div class="o-autocomplete dropdown">
                                                        <input type="text" class="o-autocomplete--input o_input edit_mode" 
                                                        t-att-name="fieldName" t-on-change="(ev) => onFieldEdit(row.id, fieldName, ev.target.value)"
                                                        autocomplete="off" placeholder="" 
                                                        t-att-value="row.data[fieldName]?.label || ''" 
                                                        style="margin-top:3px!important;height: 30px!important;"
                                                        />
                                                    </div>
                                                    <span class="o_dropdown_button" style="top:13px!important;"></span>
                                                </div>
                                                <!--<button type="button" class="btn btn-link text-action oi o_external_button oi-arrow-right" 
                                                    tabindex="-1" draggable="false" aria-label="Internal link" data-tooltip="Internal link"
                                                    ></button>-->
                                            </div>
                                            <div class="o_field_many2one_extra"></div>
                                        </div>
                                    </td>
                                </t>
                                <t t-else="else">
                                <td class="text-left">
                                    <t t-if="state.isEditing">
                                        <!-- Editable row group fields -->
                                        <t t-if="getFieldType(fieldName) === 'date'">
                                            <input type="date" t-att-name="fieldName"
                                                t-att-value="formatDate(row.data[fieldName]?.value,getFieldType(fieldName))" 
                                                t-on-change="(ev) => onFieldEdit(row.id, fieldName, ev.target.value)"
                                                class="form-control edit_mode o_field_date"/>
                                        </t>
                                        <!--<t t-elif="getFieldType(fieldName) === 'many2one'">
                                            <select class="form-select edit_mode o_list_many2one" t-att-name="fieldName"
                                                    t-on-change="(ev) => onFieldEdit(row.id, fieldName, ev.target.value)">
                                                <t t-foreach="getMany2OneOptions(fieldName)" t-as="option" t-key="option.id">
                                                    <option t-att-value="option.id" 
                                                            t-att-selected="option.id === row.data[fieldName]?.value">
                                                        <t t-esc="option.display_name"/>
                                                    </option>
                                                </t>
                                            </select>
                                            
                                        </t>-->
                                        <t t-elif="getFieldType(fieldName) === 'selection'">
                                            <select class="form-select edit_mode o_list_selection" t-att-name="fieldName"
                                                    t-on-change="(ev) => onFieldEdit(row.id, fieldName, ev.target.value)">
                                                <t t-foreach="getSelectionOptions(fieldName)" t-as="option" t-key="option.id">
                                                    <option t-att-value="option[0]"
                                                            t-att-selected="option[0] === row.data[fieldName]?.value">
                                                        <t t-esc="option[1]"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </t>
                                        <t t-else="">
                                            <input type="text" t-att-name="fieldName"
                                                t-att-value="row.data[fieldName]?.value"
                                                t-on-change="(ev) => onFieldEdit(row.id, fieldName, ev.target.value)"
                                                class="form-control edit_mode"/>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <!-- Non-edit mode display -->
                                        <span t-esc="row.data[fieldName]?.label"/>
                                    </t>
                                </td>
                                </t>
                            </t>
                        </t>
                        
                        
                        <!-- Measurement values -->
                        
                        <t t-foreach="row.subGroupMeasurements" t-as="cell" t-key="'row_cell_' + cell_index">
                            <td class="text-end"
                                t-att-class="{
                                    'cursor-pointer': cell.value !== undefined,
                                    'font-weight-bold': cell.isBold
                                }">
                                <t t-if="state.isEditing">
                                    <t t-if="getFieldType(cell.measure) === 'float' or getFieldType(cell.measure) === 'integer'">
                                        <input type="number"
                                            t-att-value="cell.value || 0"
                                            t-on-change="(ev) => onFieldEdit(row.id, cell.measure, Number(ev.target.value))"
                                            class="form-control edit_mode"/>
                                    </t>
                                    <t t-else="">
                                        <input type="text"
                                            t-att-value="cell.value || ''"
                                            t-on-change="(ev) => onFieldEdit(row.id, cell.measure, ev.target.value)"
                                            class="form-control edit_mode"/>
                                    </t>
                                </t>
                                <t t-else="">
                                    <t t-esc="cell.value || '-'"/>
                                </t>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>

    <t t-name="matrix_view.MatrixHeader">
        <th
            class="bg-view text-nowrap cursor-pointer fw-normal user-select-none"
            t-att-colspan="isXAxis ? cell.width : undefined"
            t-att-rowspan="isXAxis ? cell.height : undefined"
            t-att-class="{
                o_matrix_header_cell_closed: cell.isLeaf,
                o_matrix_header_cell_opened: !cell.isLeaf,
                'border-top': isInHead,                
            }"
            t-attf-style="{{
                isXAxis
                    ? undefined
                    : l10n.direction === 'ltr'
                        ? 'padding-left: ' + getPadding(cell) + 'px;'
                        : 'padding-right: ' + getPadding(cell) + 'px;'
            }}"
            t-att-data-tooltip="cell.label"
            t-attf-data-tooltip-position="{{ l10n.direction === 'ltr' ? 'right' : 'left' }}"
            t-on-click.prevent="() => this.onHeaderClick(cell, isXAxis ? 'col' : 'row')"
        >
            <t t-if="cell.isLeaf and !cell.isFolded">
                <MatrixGroupByMenu
                    toggler="'parent'"
                    position="isXAxis ? 'bottom-start' : 'bottom-end'"
                    cell="cell"
                    customGroupBys="model.metaData.customGroupBys"
                    onItemSelected="(payload) => this.onGroupBySelected(isXAxis ? 'col' : 'row', payload)"
                    onAddCustomGroupBy="fieldName => this.onAddCustomGroupBy(isXAxis ? 'col' : 'row', cell.groupId, fieldName)"
                />
            </t>
            <!--<i t-attf-class="fa fa-{{ cell.isLeaf ? 'plus-square' : 'minus-square-o' }} me-1"/>-->
            <span t-esc="cell.title"/>
        </th>
    </t>

    <t t-name="matrix_view.MatrixMeasure">
        <th class="bg-view text-muted text-center text-nowrap fw-normal" t-att-colspan="cell.width" t-att-rowspan="cell.height" t-att-class="{
                'o_matrix_origin_row cursor-pointer user-select-none': cell.originIndexes,
                'o_matrix_measure_row cursor-pointer user-select-none': !cell.originIndexes,
                o_matrix_sort_order_asc: cell.order === 'asc',
                o_matrix_sort_order_desc: cell.order === 'desc',
            }" t-on-click.prevent="() => this.onMeasureClick(cell)" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
            <t t-esc="cell.title"/>
            <i t-if="cell.order === 'asc' || cell.order ==='desc'" t-attf-class="fa fa-caret-{{ cell.order === 'asc' ? 'up' : 'down' }} ms-1"/>
        </th>
    </t>

</templates>
