    <record id="view_matrix_analytic_line" model="ir.ui.view">
        <field name="name">analytic.line.matrix.model</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <matrix string="Analytic Matrix View" default_order="date desc" no_total="1">
                
                <field name="date" type="row" widget="date" readonly="0"/>
                <field name="partner_id" type="row" context="{'default_partner_id':10}" onchange="get_account_domain_ids"/>
                <field name="account_domain" type="domain" invisible="1"/>
                <field name="product_id" type="col" domain="[('id','in',product_domain)]" readonly="0" />
                <field name="account_id" type="row" readonly="0" invisible="0" direction="left" domainFunction="get_account_domain_ids"/>
                <field name="note" type="row" direction="right"/>
                <field name="move_line_id" type="row" invisible="1"/>
                <field name="product_domain" type="domain" invisible="1"/>
                <!--<field name="analytic_distribution" type="col" widget="analytic_distribution"/>-->
                <field name="amount" type="measure"/>
            </matrix>
        </field>
    </record>
