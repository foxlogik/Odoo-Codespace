    <record model="ir.actions.act_window" id="analytic.account_analytic_line_action">
        <field name="context">{'search_default_group_date': 1,'default_product_id':16,'default_partner_id':1}</field>
        <field name="domain">[('product_id','!=',False)]</field>
        <field name="name">Gross Margin</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">tree,form,graph,pivot,matrix</field>
        <field name="view_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="search_view_id" ref="analytic.view_account_analytic_line_filter"/>
    </record>
    <record model="ir.actions.act_window" id="analytic.account_analytic_line_action_entries">
        <field name="name">Analytic Items</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">tree,kanban,form,graph,pivot,matrix</field>
        <field name="view_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="search_view_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="context">{'default_product_id':16,'default_partner_id':1}</field>
        <field name="domain">[('product_id','!=',False),('product_id.default_code','in',('E-COM09','E-COM06'))]</field>
    </record>


    <record id="view_matrix_move_line" model="ir.ui.view">
        <field name="name">move.line.matrix.model</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <matrix string="Journal Matrix View" default_order="date desc" no_total="1">
                
                <field name="date" type="row" widget="date"/>
                <field name="account_id" type="row" domain="[('deprecated','=',False)]"/>
                <field name="product_id" type="col" />
                <field name="analytic_distribution" type="col" widget="analytic_distribution"/>
                <field name="partner_id" type="row" context="{'default_partner_id':10}"/>
                <field name="debit" type="measure"/>
            </matrix>
        </field>
    </record>

</odoo>