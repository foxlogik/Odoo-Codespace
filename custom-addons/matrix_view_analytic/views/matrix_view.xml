    <record id="view_matrix_analytic_line" model="ir.ui.view">
        <field name="name">analytic.line.matrix.model</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <matrix string="Analytic Matrix View" default_order="date desc" no_total="1">
                
                <field name="date" type="row" widget="date"/>
                <field name="account_id" type="row" domain="[('plan_id', 'child_of', 1),('active','=',True)]"/>
                <field name="product_id" type="col" domain="[('id','=',1)]"/>
                <field name="partner_id" type="row" context="{'default_partner_id':10}"/>
                <field name="amount" type="measure"/>
            </matrix>
        </field>
    </record>
